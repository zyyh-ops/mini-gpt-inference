+    def _max_kv_blocks(self, seq: SequenceState) -> int:
+        # The first output token is produced by the final prefill logits;
+        # the last generated output token is never appended to KV on finish.
+        # So at most max_tokens - 1 tokens are ever resident in KV.
+        cached_tokens = seq.max_tokens - 1
+        bsz = self.block_manager.block_size
+        return (cached_tokens + bsz - 1) // bsz
+
+    def _can_admit_without_preemption(self, seq: SequenceState) -> bool:
+        # Reserve logical capacity for each admitted sequence's worst-case
+        # KV demand, while letting BlockManager allocate physical blocks lazily.
+        active = self.running + self.prefilling
+        committed = sum(self._max_kv_blocks(s) for s in active)
+        return committed + self._max_kv_blocks(seq) <= self.block_manager.num_blocks
+
     def add_request(
